{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "joinads/reward-countdown",
  "version": "0.4.0",
  "title": "Contagem regressiva",
  "category": "design",
  "icon": "clock",
  "description": "Prazo da campanha ou por visitante. Não altera o anúncio.",
  "attributes": {
    "label": {
      "type": "string",
      "default": "Prazo da campanha"
    },
    "mode": {
      "type": "string",
      "default": "deadline"
    },
    "deadline": {
      "type": "string",
      "default": ""
    },
    "seconds": {
      "type": "number",
      "default": 900
    },
    "expiredLabel": {
      "type": "string",
      "default": "O prazo informado terminou."
    },
    "expiry": {
      "type": "string",
      "default": "message"
    },
    "timerId": {
      "type": "string",
      "default": ""
    },
    "layout": {
      "type": "string",
      "default": "classic"
    },
    "digitSize": {
      "type": "number",
      "default": 34
    },
    "clockRadius": {
      "type": "number",
      "default": 12
    },
    "accentColor": {
      "type": "string",
      "default": "#ef4444"
    },
    "unitBackground": {
      "type": "string",
      "default": "#ffffff"
    },
    "unitColor": {
      "type": "string",
      "default": "#172033"
    },
    "daysLabel": {
      "type": "string",
      "default": "Dias"
    },
    "hoursLabel": {
      "type": "string",
      "default": "Horas"
    },
    "minutesLabel": {
      "type": "string",
      "default": "Min"
    },
    "secondsLabel": {
      "type": "string",
      "default": "Seg"
    },
    "showDays": {
      "type": "boolean",
      "default": false
    },
    "urgentSeconds": {
      "type": "number",
      "default": 0
    },
    "urgentLabel": {
      "type": "string",
      "default": "O prazo está terminando"
    },
    "urgentPulse": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "color": {
      "text": true,
      "background": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true
    }
  },
  "editorScript": "ja-reward-action-editor",
  "render": "file:./render.php",
  "style": "ja-reward-studio-style"
}
